{
  "$id": "question.schema.json",
  "title": "Question",
  "type": "object",
  "required": ["id", "subject", "topicId", "format", "prompt", "basis", "standardIds", "basedOn", "source", "difficulty", "tags", "status", "updatedAt"],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
    "subject": { "enum": ["boki", "zaihyo"] },
    "topicId": { "type": "string", "minLength": 1 },
    "format": { "enum": ["tf", "choice", "flashcard", "cloze", "multi", "order"] },
    "prompt": { "type": "string", "minLength": 1 },
    "explanation": { "type": "string" },
    "basis": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["standardId", "ref"],
        "properties": {
          "standardId": { "type": "string" },
          "ref": { "type": "string", "minLength": 1 },
          "unconfirmed": { "type": "boolean" }
        },
        "additionalProperties": false
      }
    },
    "standardIds": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "basedOn": { "type": "object", "additionalProperties": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" } },
    "source": {
      "type": "object",
      "required": ["type"],
      "properties": {
        "type": { "enum": ["past_exam", "tac", "toren", "original"] },
        "detail": { "type": "string" }
      },
      "additionalProperties": false
    },
    "difficulty": { "enum": [1, 2, 3] },
    "tags": { "type": "array", "items": { "type": "string" } },
    "status": { "enum": ["unverified", "verified", "self", "needs_review", "excluded"] },
    "updatedAt": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}" },
    "answer": {},
    "answerText": { "type": "string", "minLength": 1 },
    "choices": { "type": "array", "items": { "type": "string", "minLength": 1 }, "minItems": 2 },
    "items": { "type": "array", "items": { "type": "string", "minLength": 1 }, "minItems": 2 },
    "text": { "type": "string" },
    "blanks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["options", "answer"],
        "properties": {
          "options": { "type": "array", "items": { "type": "string" }, "minItems": 2 },
          "answer": { "type": "integer", "minimum": 0 }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false,
  "allOf": [
    { "if": { "properties": { "format": { "const": "tf" } } }, "then": { "required": ["answer"], "properties": { "answer": { "type": "boolean" } } } },
    { "if": { "properties": { "format": { "const": "choice" } } }, "then": { "required": ["choices", "answer"], "properties": { "answer": { "type": "integer", "minimum": 0 } } } },
    { "if": { "properties": { "format": { "const": "flashcard" } } }, "then": { "required": ["answerText"] } },
    { "if": { "properties": { "format": { "const": "multi" } } }, "then": { "required": ["choices", "answer"], "properties": { "answer": { "type": "array", "items": { "type": "integer", "minimum": 0 }, "minItems": 1 } } } },
    { "if": { "properties": { "format": { "const": "order" } } }, "then": { "required": ["items"] } },
    { "if": { "properties": { "format": { "const": "cloze" } } }, "then": { "required": ["text", "blanks"] } }
  ]
}
